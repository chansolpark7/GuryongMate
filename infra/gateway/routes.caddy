# 게이트웨이 경로 (개발 Caddyfile·운영 Caddyfile.prod 가 같이 쓴다). 새 서비스는 여기에 한 줄 추가한다.
# 서비스 문서: /places/docs, /planner/docs, /agent/docs, /safety/docs, /routing/docs, /trip/docs
# API·대시보드 경로가 먼저, 나머지(/ 등)는 웹 앱 (맨 끝 handle). 새 API 경로를 추가하면 웹 앱보다 위에 둔다

handle /health {
	header Content-Type application/json
	respond `{"status":"ok","service":"gateway"}` 200
}

handle /places* {
	reverse_proxy places:8000
}

handle /planner* {
	reverse_proxy planner:8000
}

handle /safety* {
	reverse_proxy safety:8000
}

handle /routing* {
	reverse_proxy routing:8000
}

handle /trip* {
	reverse_proxy trip:8000
}

handle /docent* {
	reverse_proxy docent:8000
}

handle /agent* {
	# 채팅은 SSE 스트림이라 버퍼링 없이 바로 흘려보낸다
	reverse_proxy agent:8000 {
		flush_interval -1
	}
}

handle /auth* {
	reverse_proxy account:8000
}
handle /users* {
	reverse_proxy account:8000
}
handle /account* {
	# 서비스 문서 (/account/docs)
	reverse_proxy account:8000
}

# 데모 관제 대시보드 (정적 페이지, docs/console/README.md). 페이지에는 비밀이 없고 조작은 로그인·관리 토큰으로만 된다
handle /console {
	redir * /console/ 308
}
handle_path /console/* {
	root * /srv/console
	header Cache-Control no-cache
	file_server
}

# 웹 앱 (Flutter web, deploy/build_web.sh → app/build/web). 위 API·대시보드 경로에 걸리지 않은 나머지 전부.
# 운영은 이미지 안 /srv/app, 개발은 compose 가 저장소의 app/ 를 마운트해 APP_ROOT 로 알려 준다.
# Flutter 웹 빌드는 파일 이름에 해시가 없어(main.dart.js·canvaskit/…) 모두 no-cache — 브라우저가 ETag 로 확인하고 바뀌지 않았으면 304.
handle {
	root * {$APP_ROOT:/srv/app}
	@no_app not file /index.html
	handle @no_app {
		header Content-Type application/json
		respond `{"detail":"웹 앱이 빌드되지 않았습니다 (deploy/build_web.sh)"}` 404
	}
	header Cache-Control no-cache
	encode zstd gzip
	# 없는 경로는 index.html (SPA 새로고침·직접 주소). 단 앱 파일 종류(.js·.wasm 등)는 없으면 404 그대로
	@spa {
		not file
		not path *.js *.mjs *.wasm *.json *.png *.otf *.ttf *.symbols *.map
	}
	rewrite @spa /index.html
	file_server
}
