# 이 파일을 backend/.env 로 복사해서 값 채우기. .env 는 커밋하지 않는다.
# docker compose 로 띄우면 DATABASE_URL, SERVICE, EMBEDDING_URL, *_BASE_URL 은 compose 설정이 덮어쓴다.
DATABASE_URL=postgresql+psycopg://guryong:guryong@localhost:5432/guryongmate

# 인증 (account 서비스 도입 후). 운영 시 JWT_SECRET 은 반드시 바꾼다.
JWT_SECRET=dev-only-change-me
AUTH_REQUIRED=false                   # 앱·데모는 true (로그인 필수). false 면 개발용으로 X-User-Id 헤더 허용
# Google 로그인: 허용할 OAuth 클라이언트 ID (쉼표 구분, Android·iOS·Web). docs/account/README.md §3.2
ACCOUNT_GOOGLE_CLIENT_IDS=
# ACCOUNT_ACCESS_TTL_MIN=60
# ACCOUNT_REFRESH_TTL_DAYS=30

# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding 키). KorService2, Odii, 기상청 단기예보·기상특보, 조석예보에 공통 사용
DATA_GO_KR_SERVICE_KEY=

# E-UM 디지털트윈 포항(pohang-eum.kr) 인증키. URL 인코딩된 값(%2B…) 그대로. API 마다 활용신청 필요 (docs/dt/DT_API.md)
DT_SERVICE_KEY=
# 안전 정보 데이터: live(실제 API) | mock(키 없이 가짜 데이터, 가상 상황 시연용)
# SAFETY_SOURCE=live
# SAFETY_MOCK_SCENARIO=calm               # calm | rain | wind_tomorrow | flood | storm (mock 이면 PUT /safety/sim 으로 실행 중 변경)
# planner 안전 주기 점검: 상황 확인 주기는 compose 의 PLANNER_SAFETY_WATCH_SEC (기본 60초, 루트 .env 로 바꿈)
# PLANNER_SAFETY_RECHECK_MIN=10           # 상황이 그대로여도 이 주기마다 다시 점검

# 길찾기 (docs/routing/README.md). 키가 필요 없다. 엔진 주소·연결은 compose 가 넣는다
# ROUTING_WALKING_SPEED_KMH=4.2        # 기본 걷는 속도 (70m/분)
# SAFETY_AVOID_FLOOD_RADIUS_M=80       # 길찾기에서 피할 침수 센서 주변 반경

# 여행 중 (docs/trip/README.md §9). 틱 주기는 compose 의 TRIP_TICK_SEC (기본 30초, 루트 .env 로 바꿈)
# TRIP_CLOCK=safety                     # safety: safety 가상 시각을 따름 / system
# TRIP_ARRIVE_RADIUS_M=60               # 도착 반경 (+ accuracy, 최대 150)
# TRIP_ARRIVE_DWELL_SEC=90
# TRIP_DEPART_DWELL_SEC=120
# TRIP_PROACTIVE_COOLDOWN_MIN=10        # Agent 선제 턴 쿨다운 (안전 제외)

LLM_API_KEY=
KAKAO_REST_API_KEY=

# Planner Agent LLM (자세한 내용: docs/agent/README.md). 앱은 어떤 LLM 인지 몰라도 된다.
AGENT_PROVIDER=openai                 # openai (기본, gpt-5.4-mini) | local (호스트 Ollama)
AGENT_OPENAI_API_KEY=                 # 비워 두면 LLM_API_KEY 를 쓴다
# AGENT_OPENAI_MODEL=gpt-5.4-mini
# AGENT_REVIEW_ROUNDS=2               # 계획 -> 검토 -> 수정 루프. 0 이면 끔
# 로컬 LLM 을 쓸 때 (AGENT_PROVIDER=local)
# AGENT_LOCAL_MODEL=qwen3.6:35b       # 호스트 Ollama (host.docker.internal:11434)
# AGENT_LOCAL_THINK=true              # qwen3.6 은 추론을 켜야 도구를 제대로 쓴다
