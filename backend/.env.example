# 이 파일을 backend/.env 로 복사해서 값 채우기. .env 는 커밋하지 않는다.
# docker compose 로 띄우면 DATABASE_URL 은 compose 설정이 덮어쓴다.
DATABASE_URL=postgresql+psycopg://guryong:guryong@localhost:5432/guryongmate

# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding 키). KorService2, Odii 등에 공통 사용
DATA_GO_KR_SERVICE_KEY=

LLM_API_KEY=
KAKAO_REST_API_KEY=

# Planner Agent LLM (자세한 내용: docs/agent/README.md). 앱은 어떤 LLM 인지 몰라도 된다.
AGENT_PROVIDER=local                  # local | openai
AGENT_LOCAL_MODEL=qwen3.6:35b         # 호스트 Ollama (host.docker.internal:11434)
AGENT_LOCAL_THINK=true                # qwen3.6 은 추론을 켜야 도구를 제대로 쓴다
# AGENT_LOCAL_NUM_CTX=16384
# AGENT_OPENAI_MODEL=gpt-5-mini       # AGENT_PROVIDER=openai 일 때. 키는 LLM_API_KEY 를 쓴다
