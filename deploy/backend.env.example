# 서버의 서비스 설정 (VM ~/guryongmate/backend.env). deploy/backend.env 로 복사해 키를 채우면 first_deploy.sh 가 올린다 (커밋 안 함)
# DATABASE_URL·AUTH_REQUIRED·JWT_SECRET·ADMIN_TOKEN·서비스 주소는 docker-compose.prod.yml 이 넣는다 (여기 적어도 무시됨)
# 전체 항목 설명: backend/.env.example

# ----- Agent LLM (docs/agent/README.md §7) -----
AGENT_PROVIDER=claude                 # 문제 시 scripted (deploy/llm.sh scripted)
AGENT_CLAUDE_API_KEY=
# AGENT_CLAUDE_MODEL=claude-haiku-5-5

# ----- LLM 비용 보호: 사용자당 호출 수 (docs/deploy/README.md §3.3). 0 이면 제한 없음 -----
AGENT_LIMIT_CHAT_HOUR=30              # 대화 턴 (다시 제안 포함)
AGENT_LIMIT_CHAT_DAY=150
AGENT_LIMIT_EVENT_HOUR=20             # Agent 선제 안내 (여행 중 지연·안전)
AGENT_LIMIT_EVENT_DAY=60
AGENT_LIMIT_GUIDE_HOUR=3              # 가이드 준비 작업 (계획의 장소 여러 곳을 한 번에)
AGENT_LIMIT_GUIDE_DAY=10

# ----- 안전 정보 (docs/safety/README.md) -----
SAFETY_SOURCE=live
SAFETY_SIM_ENABLED=true               # 발표 장면 ④ 실제 <-> 가상 전환 (PUT /safety/sim 은 관리 토큰으로만)
DATA_GO_KR_SERVICE_KEY=
DT_SERVICE_KEY=

# ----- 그 밖 -----
ACCOUNT_GOOGLE_CLIENT_IDS=            # 비워 둔다: Google 로그인은 계정을 자동으로 만들어 가입 제한을 우회한다
DOCENT_NAVER_CLIENT_ID=
DOCENT_NAVER_CLIENT_SECRET=
